# =============================================================================
# RolyPoly — переменные окружения (.env.example)
# Скопируйте этот файл в .env и заполните реальными значениями.
# НЕ коммитьте .env с реальными секретами в репозиторий.
# =============================================================================

# --- Приложение ---
APP_NAME=RolyPoly
APP_ENV=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_V1_STR=/api/v1

# --- Безопасность (обязательно измените перед запуском!) ---
SECRET_KEY=смените-на-надёжный-секретный-ключ-не менее-32-символов
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- База данных PostgreSQL + PostGIS ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rolypoly
POSTGRES_PASSWORD=rolypoly_dev_password
POSTGRES_DB=rolypoly
# Полная строка подключения (используется Alembic и SQLAlchemy):
DATABASE_URL=postgresql+psycopg2://rolypoly:rolypoly_dev_password@localhost:5432/rolypoly
# Асинхронная строка (если понадобится):
DATABASE_URL_ASYNC=postgresql+asyncpg://rolypoly:rolypoly_dev_password@localhost:5432/rolypoly

# --- Файловое хранилище (вне базы данных) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=jpg,jpeg,png,svg,geojson,json,gpkg,tif,tiff

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ведущий / игра ---
DEFAULT_TURN_DAYS=30
MAX_PLAYERS_PER_GAME=6

# --- Уведомления (WebSocket) ---
WS_PING_INTERVAL_SECONDS=30
